# Secrets must only ever arrive as platform environment variables.
.env
backend/.env
*.session
*.session-journal

# Installed inside the image, never copied in.
node_modules
dist
backend/__pycache__
**/__pycache__
*.py[cod]
venv
.venv

# Local vector store. The container seeds its own (see start.sh); copying a
# Windows-written store into a Linux image risks a corrupt or stale corpus.
backend/chroma_db
chroma_db

# Local runtime artefacts.
backend/audit_chain_tips.log

# Documentation and report material - not needed at runtime, and they make up
# most of the repository's size.
report_assets
*.docx
*.pdf

# Repo metadata
.git
.github
.vscode
README.md
