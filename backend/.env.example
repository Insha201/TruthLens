# ── Core services ────────────────────────────────────────────
GROQ_API_KEY=your_groq_key_here
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here

# ── Live ingestion sources (implemented) ─────────────────────
NEWS_API_KEY=your_newsapi_key_here            # https://newsapi.org
YOUTUBE_API_KEY=your_youtube_data_api_key     # Google Cloud Console → YouTube Data API v3
# RSS needs no key — feeds are configured in ingestion/rss_ingestion.py

# ── Staged social connectors (scaffolded, off by default) ────
# Add a value to switch the matching source ON. Each pairs with
# backend/ingestion/<name>_ingestion.py and the include_* flag
# on POST /api/ingest/bulk.
TWITTER_BEARER_TOKEN=          # developer.x.com -> Project -> Bearer Token

# Reddit (implemented, uses praw in read-only mode)
REDDIT_CLIENT_ID=              # reddit.com/prefs/apps -> create app, type "script"
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=truthlens-ingestion/0.1

# Telegram (implemented, uses Telethon / MTProto).
# A BOT token will NOT work for reading public channels.
# Get api_id + api_hash from my.telegram.org -> API development tools,
# then run once from backend/:  python -m ingestion.telegram_login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=truthlens

# TikTok (implemented against the Research API, which requires an approved
# application: developers.tiktok.com/products/research-api/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

WHATSAPP_API_KEY=             # Meta / WhatsApp Business Cloud API token
